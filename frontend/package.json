    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
